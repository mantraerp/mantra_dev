 "html": "{%- from \"templates/print_formats/standard_macros.html\" import add_header, render_field -%}\r\n\r\n<!-- Outer container for the print format with some styling -->\r\n<div class=\"print-format .print-format-preview\" style=\"padding-left: 0px;\">\r\n\r\n    <!-- Page Header Section -->\r\n    <!--<div class=\"page-header\">-->\r\n        <!--{{ add_header(0, 1, doc, letter_head, no_letterhead) }}-->\r\n    <!--    {% if not no_letterhead and footer %}-->\r\n    <!--     <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed; border-bottom: 1px solid #ddd;  \">-->\r\n    <!--        <tbody><tr style=\"border: 0px; background: none;\">-->\r\n                 <!--Left Section -->\r\n    <!--            <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">-->\r\n    <!--                <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">-->\r\n                    <!--<p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">CIN No.: U72200GJ2006PTC048092</p>-->\r\n                    <!--<p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">GSTIN: 24AAECM6360N1Z6</p>-->\r\n    <!--            </td>-->\r\n                 <!--Right Section -->\r\n    <!--            <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">-->\r\n                    \r\n    <!--                {% set doc1 = frappe.get_doc(\"Address\",doc.billing_address)%}-->\r\n    <!--                <h3 style=\"font-size: 13px;  margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>-->\r\n                    <!--<p style=\"margin: 0; font-size: 13px;\">(ISO 9001: 2015 COMPANY)</p>-->\r\n                    <!--<p style=\"margin: 0; font-size: 13px;\">B203-Shapath Hexa, Nr. Gujarat High Court, S.G. Highway</p>-->\r\n    <!--                <p style=\"margin: 0; font-size: 13px;\">{{doc1.address_line1 or ''}},{{doc1.address_line2 or ''}}</p>-->\r\n                    <!--<p style=\"margin: 0; font-size: 13px;\">Ahmedabad, Gujarat, India, 380060</p>-->\r\n    <!--                <p style=\"margin: 0; font-size: 13px;\">{{doc1.city or ''}}, {{doc1.state or ''}}, {{doc1.country or ''}}, {{doc1.pincode or ''}}</p>-->\r\n    <!--            </td>-->\r\n                \r\n    <!--        </tr>-->\r\n    <!--    </tbody></table>-->\r\n    <!--    {% endif %}-->\r\n    <!--</div>-->\r\n    \r\n    \r\n    <div id=\"header-html\" class=\"visible-pdf\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-header\" style=\"padding: 0; margin: 0; height: auto;\">\r\n        <table style=\"border-bottom: 1px solid #ddd; width: 100%; margin: 0; padding: 0;\">\r\n            <tr style=\"border: 0px; background: none;\">\r\n                <!-- Left Section -->\r\n                <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">\r\n                    <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">\r\n                    <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">CIN No.: U72200GJ2006PTC048092</p>\r\n                    <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">GSTIN: 24AAECM6360N1Z6</p>\r\n                </td>\r\n                <!-- Right Section -->\r\n                <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">\r\n                    {% set doc1 = frappe.get_doc(\"Address\", doc.billing_address) %}\r\n                    <h3 style=\"font-size: 13px; margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>\r\n                    <p style=\"margin: 0; font-size: 13px;\">{{ doc1.address_line1 or '' }}, {{ doc1.address_line2 or '' }}</p>\r\n                    <p style=\"margin: 0; font-size: 13px;\">{{ doc1.city or '' }}, {{ doc1.state or '' }}, {{ doc1.country or '' }}, {{ doc1.pincode or '' }}</p>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n</div>\r\n    \r\n   \r\n    \r\n\r\n    <!-- Page Footer Section -->\r\n    <!--<div class=\"page-footer\">-->\r\n    <!--    {{ footer }}-->\r\n    <!--</div>-->\r\n\r\n    <div id=\"footer-html\" class=\"visible-pdf\">\r\n\t\t{% if not no_letterhead and footer %}\r\n\t\t<div class=\"letter-head-footer\" style=\"border-top: 1px solid black; border-bottom: 1px solid black;\">\r\n\t\t\t<!--{{ footer }}-->\r\n\t\t\t<p><center>Registered Office Address: B-203, 2nd Floor, Shapath Hexa, Near Gujarat High Court, Opp. Kargil Petrol Pump,S.G.\r\nHighway,Sola, Ahmedabad, Gujarat - 380060, India</center></p>\r\n\t\t</div>\r\n\t\t{% endif %}\r\n\t\t<div style=\"text-left: right; position: fixed; bottom: 4px; left:-1px; width: 100%;\">\r\n\t\t    RFQ / PO No.:{{ doc.name }}\r\n\t\t    \r\n\t\t</div>\r\n\t\t\r\n\t\t<div style=\"text-align: right; position: fixed; bottom: 4px; left:-1px; width: 100%;\">\r\n    {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n        </div>\r\n\r\n\t\t<!--<p class=\"text-center small page-number visible-pdf\">-->\r\n\t\t<!--\t{{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}-->\r\n\t\t<!--</p>-->\r\n\t</div>\r\n\r\n    <!-- Table for the entire print format -->\r\n    <table>\r\n\r\n        <!-- Table Header Section -->\r\n        <thead>\r\n            <tr>\r\n                <td>\r\n                    <!-- Placeholder for the fixed-position header -->\r\n                    <div class=\"page-header-space\"></div>\r\n                </td>\r\n            </tr>\r\n        </thead>\r\n\r\n        <!-- Table Body Section -->\r\n        <tbody>\r\n            <tr>\r\n                <td>\r\n                    <!-- Placeholder for the main content of the print format -->\r\n\r\n                    <!-- PO Status (Draft or Cancelled) -->\r\n                    <div>\r\n                        {% if doc.status == \"Draft\" %}\r\n                            <h1 style=\"text-align: center; margin-top:-60px;\">Draft</h1>\r\n                        {% endif %}\r\n                        {% if doc.status == \"Cancelled\" %}\r\n                            <h1 style=\"text-align: center; margin-top:-60px;\">Cancelled</h1>\r\n                        {% endif %}\r\n                        {% if doc.status != \"Draft\" and doc.status != \"Cancelled\" %}\r\n                            <h1 style=\"text-align: center; margin-top:-60px;\">Purchase Order #{{ doc.name or ' ' }}</h1>\r\n                        {% endif %}\r\n                    </div>\r\n\r\n                    <!-- Supplier and Shipping Address Section -->\r\n                    <div>\r\n                        <table style=\"width: 100%;\">\r\n                            <tr style=\"padding: 0 !important; display: flex; gap: 110px;\">\r\n                                <!-- Supplier Address -->\r\n                                <td style=\"width: 50%; padding: 0 !important; vertical-align: top;\">\r\n                                    <p style=\"margin: 0;\"><b>Supplier address:</b></p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ doc.supplier_name or ' ' }}</p>\r\n                                    \r\n                                    {% set supplier_address = frappe.db.get_value('Address', doc.supplier_address, ['address_title', 'address_type', 'address_line1', 'address_line2', 'city', 'country', 'state', 'pincode', 'gstin', 'custom_mobile_no']) %}\r\n                                    \r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_address[2] or ' ' }} {{ supplier_address[3] or ' ' }}</p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_address[4] or ' ' }} {{ supplier_address[6] or ' ' }}</p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_address[5] or ' ' }} {{ supplier_address[7] or ' ' }}</p>\r\n\r\n                                    {% if supplier_address[9] %}\r\n                                        <p style=\"margin: 0; opacity: 0.8;\">\r\n                                            <img style=\"height: 15px; width: 15px;\" src=\"/files/call.png\"> {{ supplier_address[9] or ' ' }}\r\n                                        </p>\r\n                                    {% endif %}\r\n\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ doc.supplier_gstin or ' ' }}</p>\r\n                                </td>\r\n\r\n                                <!-- Shipping Address -->\r\n                                <td style=\"width: 50%; padding: 0 !important;\">\r\n                                    {% set supplier_shipping_address = frappe.db.get_value('Address', doc.shipping_address, ['address_title', 'address_type', 'address_line1', 'address_line2', 'city', 'country', 'state', 'pincode', 'phone', 'gstin', 'custom_mobile_no']) %}\r\n                                    <p style=\"margin: 0; opacity: 0.8;\"><b>Shipping address:</b></p>\r\n\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ doc.shipping_address }}</p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_shipping_address[2] or ' ' }} {{ supplier_shipping_address[3] or ' ' }}</p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_shipping_address[4] or ' ' }} {{ supplier_shipping_address[6] or ' ' }}</p>\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_shipping_address[5] or ' ' }} {{ supplier_shipping_address[7] or ' ' }}</p>\r\n\r\n                                    {% if supplier_shipping_address[10] %}\r\n                                        <p style=\"margin: 0; opacity: 0.8;\">\r\n                                            <img style=\"height: 15px; width: 15px;\" src=\"/files/call.png\"> {{ supplier_shipping_address[10] or ' ' }}\r\n                                        </p>\r\n                                    {% endif %}\r\n\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ supplier_shipping_address[9] or ' ' }}</p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n\r\n                    <!-- PO Details Section -->\r\n                    <div>\r\n                        <table style=\"width: 100%;\">\r\n                            <tr style=\"padding: 0 !important; display: flex; gap: 150px;\">\r\n                                <td style=\"width: fit-content; padding: 0 !important;\">\r\n                                    <p><b>PO NO : {{ doc.name or ' ' }}</b></p>\r\n                                    <p><b>PO Date : {{ doc.get_formatted(\"transaction_date\") or ' ' }}</b></p>\r\n                                </td>\r\n\r\n                                <td style=\"width: fit-content; padding: 0 !important;\">\r\n                                    <p><b>Incoterms : {{ doc.incoterm or ' ' }}</b></p>\r\n                                    <p><b>Purchase Representative : {{ doc.custom_purchase_person or ' ' }}</b></p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n\r\n                    <!-- Purchase Order Body Section -->\r\n                    <div style=\"padding: 1px\">\r\n                        <p style=\"margin: 0; opacity: 0.8;\">Dear Sir,</p>\r\n                        <p style=\"margin: 0; opacity: 0.8;\">We are pleased to issue this Purchase Order for the material/s listed below, subject to the terms and conditions obtained here in and in the annexure/s to this PO.</p>\r\n                    </div>\r\n\r\n                    <!-- PO Items Table -->\r\n                    <table style=\"width: 100%; border-top: 1px solid rgba(0, 0, 0, 0.3);\">\r\n                        <tr style=\"padding: 0 !important;\">\r\n                            <th style=\"padding: 0 !important; text-align: left; padding-bottom: 5px !important;\"><b>Description</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: left; padding-bottom: 5px !important;\"><b>Part Code</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: center; padding-bottom: 5px !important;\"><b>Date Req.</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: right; padding-bottom: 5px !important;\"><b>Qty</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: right; padding-right: 5px !important;\"><b>Unit Price</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: left; padding-bottom: 5px !important;\"><b>Taxes</b></th>\r\n                            <th style=\"padding: 0 !important; text-align: right; padding-bottom: 5px !important;\"><b>Amount</b></th>\r\n                        </tr>\r\n\r\n                        {% for item in doc.items %}\r\n                            <tr style=\"padding: 0 !important; background-color: #f1eded;\">\r\n                                <td style=\"text-align: left; padding-top: 5px !important;\">\r\n                                    <p style=\"margin: 0; opacity: 0.8;\">{{ item.custom_item_description or item.item_name }}</p>\r\n                                    <p style=\"margin: 0; padding-left: 5px;\"><b>HSN/SAC Code:</b><span style=\"opacity: 0.8;\">{{ item.gst_hsn_code or ' ' }}</span></p>\r\n                                </td>\r\n                                <td style=\"text-align: left; opacity: 0.8; padding-top: 3px !important;\">{{ item.supplier_part_no or ' ' }}</td>\r\n                                <td style=\"text-align: center; opacity: 0.8; padding-top: 3px !important;\">{{ item.get_formatted(\"schedule_date\") or ' ' }}</td>\r\n                                <td style=\"text-align: right; opacity: 0.8; padding-top: 3px !important;\">{{ item.qty or ' ' }} {{ item.uom or ' ' }}</td>\r\n                                <td style=\"text-align: right; opacity: 0.8; padding-top: 3px !important;\">{{ item.get_formatted(\"rate\") or '' }}</td>\r\n                                <td style=\"text-align: left; opacity: 0.8; padding\r\n                                <td style=\"text-align: left; opacity: 0.8; padding-top: 3px !important;\">\r\n                                    {{ item.item_tax_template or ' ' }}\r\n                                </td>\r\n                                <td style=\"text-align: right; opacity: 0.8; padding-top: 3px !important;\">\r\n                                    {{ item.get_formatted(\"amount\") or '' }}\r\n                                </td>\r\n                            </tr>\r\n\r\n                            <!-- Display description in white background after each row -->\r\n                            <tr style=\"padding: 0 !important;\">\r\n                                <td colspan=\"7\" style=\"padding: 0 !important; background-color: white;\">\r\n                                    <p style=\"margin: 0; background-color: white;\">{{ item.custom_note or '' }}</p>\r\n                                </td>\r\n                            </tr>\r\n                        {% endfor %}\r\n                    </table>\r\n\r\n                    <!-- Total Amount Section -->\r\n                    <div style=\"padding: 20px;\"></div>\r\n                    <!--<div style=\"display: flex !important; justify-content: right !important;\">-->\r\n                        <table  style=\"width:100%\">\r\n                            <tr style=\"padding: 0 !important; \">\r\n                                <td width=\"60%\"></td>\r\n                                <td style=\"border-top: 1px solid rgba(0, 0, 0, 0.3);\"><b>Untaxed Amount</b></td>\r\n                                <td style=\"opacity: 0.8; border-top: 1px solid rgba(0, 0, 0, 0.3);\">{{ doc.get_formatted(\"total\") or '' }}</td>\r\n                            </tr>\r\n\r\n                            <!--{% set cgst_rendered = false %}-->\r\n                            <!--{% for tax in doc.taxes %}-->\r\n                            <!--    {% if doc.tax_category == \"In-State\" %}-->\r\n                            <!--        {% if not cgst_rendered %}-->\r\n                            <!--            <tr style=\"padding: 0 !important;\">-->\r\n                            <!--                <td></td>-->\r\n                            <!--                <td style=\"opacity: 0.8;\">CGST on {{ doc.get_formatted(\"total\") or '' }}</td>-->\r\n                            <!--                <td style=\"text-align: right; opacity: 0.8;\">{{ tax.get_formatted(\"tax_amount\") or '' }}</td>-->\r\n                            <!--            </tr>-->\r\n                            <!--            {% set cgst_rendered = true %}-->\r\n                            <!--        {% else %}-->\r\n                            <!--            <tr style=\"padding: 0 !important;\">-->\r\n                            <!--                <td></td>-->\r\n                            <!--                <td style=\"opacity: 0.8;\">SGST on {{ doc.get_formatted(\"total\") or '' }}</td>-->\r\n                            <!--                <td style=\"text-align: right; opacity: 0.8;\">{{ tax.get_formatted(\"tax_amount\") or '' }}</td>-->\r\n                            <!--            </tr>-->\r\n                            <!--        {% endif %}-->\r\n                            <!--    {% else %}-->\r\n                            <!--        <tr style=\"padding: 0 !important;\">-->\r\n                            <!--            <td></td>-->\r\n                            <!--            <td style=\"opacity: 0.8;\">IGST on {{ doc.get_formatted(\"total\") or '' }}</td>-->\r\n                            <!--            <td style=\"text-align: right; opacity: 0.8;\">{{ tax.get_formatted(\"tax_amount\") or '' }}</td>-->\r\n                            <!--        </tr>-->\r\n                            <!--    {% endif %}-->\r\n                            <!--{% endfor %}-->\r\n                            \r\n                            {% if doc.taxes %}\r\n                            {% for tax in doc.taxes %}\r\n                                        <tr style=\"padding: 0 !important;\">\r\n                                            <td></td>\r\n                                            <td style=\"opacity: 0.8;\">{{tax.description}} on {{ doc.get_formatted(\"total\") or '' }}</td>\r\n                                            <td style=\"text-align: right; opacity: 0.8;\">{{ tax.get_formatted(\"tax_amount\") or '' }}</td>\r\n                                        </tr>\r\n                                    \r\n                            {% endfor %}\r\n                            {% endif %}\r\n\r\n                            <tr style=\"padding: 0 !important; \">\r\n                                <td width=\"60%\" ></td>\r\n                                <td style = \"border-bottom: 1px solid rgba(0, 0, 0, 0.3);\"><b>Total</b></td>\r\n                                <td style=\"border-bottom: 1px solid rgba(0, 0, 0, 0.3); opacity: 0.8;\">{{ doc.get_formatted(\"grand_total\") or '' }}</td>\r\n                            </tr>\r\n                        </table>\r\n                    <!--</div>-->\r\n\r\n                    <!-- Payment Terms Section -->\r\n                    <div>\r\n                        <p style=\"padding-bottom: 10px;\"><b>Payment Terms: {{ doc.payment_terms_template or '' }}</b></p>\r\n                    </div>\r\n\r\n                    <!-- Terms & Conditions Section -->\r\n                    <div>\r\n                        <div style=\"opacity: 0.8;\">\r\n                            <p style=\"opacity: 0.8; border-top: 1px solid rgba(0, 0, 0, 0.3); border-bottom: 1px solid rgba(0, 0, 0, 0.3); padding: 10px 0 10px 0;\">\r\n                                <b>Terms & Conditions:</b>\r\n                            </p>\r\n                            <p style =\"background-color:white !important;\">{{ doc.terms or '' }}</p>\r\n                        </div>\r\n                    </div>\r\n\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n\r\n        <!-- Table Footer Section -->\r\n        <!--<tfoot>-->\r\n        <!--    <tr>-->\r\n        <!--        <td>-->\r\n                    <!-- Placeholder for the fixed-position footer -->\r\n        <!--            <div class=\"page-footer-space\"></div>-->\r\n        <!--        </td>-->\r\n        <!--    </tr>-->\r\n        <!--</tfoot>-->\r\n\r\n    </table>\r\n</div>\r\n",
