 "css": "/* Global Styles for Print */\r\n@media print {\r\n    /* Ensures page breaks happen at specified locations */\r\n    .page-break-before {\r\n        page-break-before: always;\r\n    }\r\n\r\n    /* Adjust the body layout for printing */\r\n    body {\r\n        margin: 0;\r\n        counter-reset: page;\r\n    }\r\n\r\n    /* Hide buttons during print */\r\n    button {\r\n        display: none;\r\n    }\r\n\r\n    /* Page size and margins */\r\n    @page {\r\n        size: A4 portrait;\r\n        margin: 10mm;\r\n    }\r\n\r\n    /* Page number formatting */\r\n    .page-no::after {\r\n        counter-increment: page;\r\n        content: \"Page \" counter(page);\r\n    }\r\n\r\n    /* Header and Footer Styles */\r\n    .page-header, .page-footer {\r\n        position: fixed;\r\n        width: 100%;\r\n        margin: auto;\r\n    }\r\n\r\n    .page-header {\r\n        top: 0;\r\n        height: 50px; /* Adjust as needed */\r\n        border-bottom: 0 !important;\r\n        display: block;\r\n        color: #ffffff;\r\n        padding-left: 0 !important;\r\n    }\r\n\r\n    .page-footer {\r\n        bottom: 0;\r\n        height: 50px; /* Adjust as needed */\r\n        display: block;\r\n    }\r\n\r\n    .page-header-space, .page-footer-space {\r\n        height: 50px; /* Adjust space if necessary */\r\n    }\r\n\r\n    /* Table headers and footers */\r\n    thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    tfoot {\r\n        display: table-footer-group;\r\n    }\r\n\r\n    /* Formatting for page breaks and section headers */\r\n    .print-format .print-format-preview {\r\n        padding-left: 0px !important;\r\n        padding-top: 0px !important;\r\n    }\r\n\r\n    /* Page break and spacing for scoped content */\r\n    .scope-work {\r\n        margin-inline: 60px;\r\n        margin-bottom: 30px;\r\n    }\r\n\r\n    /* Scoped table style */\r\n    .scope-work-table {\r\n        border: 1px solid black;\r\n        color: black !important;\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .scope-work-table th {\r\n        background-color: #c9daf8;\r\n        color: black !important;\r\n        text-align: center;\r\n        font-weight: bold !important;\r\n    }\r\n\r\n    .scope-work-table th:nth-child(1),\r\n    .scope-work-table th:nth-child(2) {\r\n        width: 20%;\r\n        min-width: 150px;\r\n    }\r\n\r\n    .scope-work-table th:nth-child(3) {\r\n        width: 60%;\r\n    }\r\n\r\n    /* Table for tests */\r\n    .test-table {\r\n        color: black !important;\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .test-table td {\r\n        text-align: left;\r\n        border-bottom: 1px solid black;\r\n        border-left: 1px solid black;\r\n        border-right: 1px solid black;\r\n    }\r\n\r\n    .test-table td:nth-child(1),\r\n    .test-table td:nth-child(2) {\r\n        width: 20%;\r\n        min-width: 150px;\r\n    }\r\n\r\n    .test-table td:nth-child(3) {\r\n        width: 60%;\r\n    }\r\n\r\n    /* Custom Heading Styles */\r\n    .print-heading {\r\n        display: none;\r\n    }\r\n\r\n    .text-center h4 {\r\n        display: none;\r\n    }\r\n\r\n    /* Page header margin for print */\r\n    .page-header {\r\n        margin-top: 0px !important;\r\n    }\r\n    \r\n    /*.page {*/\r\n    /*        page-break-after: always;*/\r\n    /*    }*/\r\n    .ql-editor.read-mode p span {\r\n    background-color: transparent !important; /* Remove background color */\r\n    font-size: 14px;\r\n    color: rgb(248, 248, 248);\r\n}\r\n}\r\n",
