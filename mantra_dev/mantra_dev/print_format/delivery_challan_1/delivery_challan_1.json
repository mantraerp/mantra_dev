 "html": "{%- from \"templates/print_formats/standard_macros.html\" import add_header, render_field -%}\n\n<!-- Outer container for the print format with some styling -->\n<div class=\"print-format .print-format-preview\" style=\"padding: 0px; \">\n   <!-- Page Header Section -->\n\n\n    <div style=\"width: 100%;\">\n    <!-- Table Layout for Header -->\n        <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed; border: 2px solid black; \">\n            <tbody><tr style=\"border: 0px; background: none;\">\n                <!-- Left Section -->\n                <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">\n                    <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">\n                    <p style=\"margin: 0; padding-top: 10px; font-size: 13px;\"><b>CIN No.: U72200GJ2006PTC048092</b></p>\n                </td>\n                <!-- Right Section -->\n                <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">\n                    <h3 style=\"font-size: 13px; color: cornflowerblue; margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>\n                    <p style=\"margin: 0; font-size: 13px;\">(ISO 9001: 2015 COMPANY)</p>\n                    <p style=\"margin: 0; font-size: 13px;\">B203-Shapath Hexa, Nr. Gujarat High Court, S.G. Highway</p>\n                    <p style=\"margin: 0; font-size: 13px;\">Ahmedabad, Gujarat, India, 380060</p>\n                </td>\n            </tr>\n        </tbody></table>\n\n    <!-- Separator -->\n    <!--<div style=\"width: 100%; border-bottom: 2px solid rgba(0, 0, 0, 0.5);\"></div>-->\n    </div>\n    \n    \n    \n\n\n   <!--<div class=\"page-header\">-->\n   <!--   {{ add_header(0, 1, doc, letter_head, no_letterhead,page_num ) }}-->\n   <!--</div>-->\n   <!-- Page Footer Section -->\n   <!--<div class=\"page-footer\">-->\n   <!--   {{footer or \"\"}}-->\n   <!--   {%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead) -%}-->\n   <!--   <div style=\"display:block;\"> {{page_num}} of {{max_pages}}</div>-->\n   <!--   {%- endmacro -%}-->\n\n   <!--</div>-->\n   <!-- Table for the entire print format -->\n   \n   \n   <div id=\"header-html\" class=\"visible-pdf\">\n    {% if not no_letterhead and footer %}\n    <div class=\"letter-head-header\" style=\"padding: 0; margin: 0; height: auto;\">\n        <table style=\"border-bottom: 1px solid #ddd; width: 100%; margin: 0; padding: 5px;\">\n            <!--<tr style=\"border: 0px; background: none;\">-->\n                <!-- Left Section -->\n            <!--    <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">-->\n            <!--        <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">-->\n            <!--        <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">CIN No.: U72200GJ2006PTC048092</p>-->\n            <!--        <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">GSTIN: 24AAECM6360N1Z6</p>-->\n            <!--    </td>-->\n                <!-- Right Section -->\n            <!--    <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">-->\n            <!--        {% set doc1 = frappe.get_doc(\"Address\", doc.billing_address) %}-->\n            <!--        <h3 style=\"font-size: 13px; margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>-->\n            <!--        <p style=\"margin: 0; font-size: 13px;\">{{ doc1.address_line1 or '' }}, {{ doc1.address_line2 or '' }}</p>-->\n            <!--        <p style=\"margin: 0; font-size: 13px;\">{{ doc1.city or '' }}, {{ doc1.state or '' }}, {{ doc1.country or '' }}, {{ doc1.pincode or '' }}</p>-->\n            <!--    </td>-->\n            </tr>\n        </table>\n    </div>\n    {% endif %}\n</div>\n   \n <!--  <div id=\"footer-html\" class=\"visible-pdf\">-->\n\t\n\t<!--\t<div style=\"text-left: right; position: fixed; bottom: 4px; left:-1px; width: 100%;\">-->\n\t<!--\t    RFQ / PO No.:{{ doc.name }}-->\n\t\t    \n\t<!--\t</div>-->\n\t\t\n\t<!--\t<div style=\"text-align: right; position: fixed; bottom: 4px; left:-1px; width: 100%;\">-->\n <!--   {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}-->\n <!--       </div>-->\n\n\t\t<!--<p class=\"text-center small page-number visible-pdf\">-->\n\t\t<!--\t{{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}-->\n\t\t<!--</p>-->\n\t<!--</div>-->\n\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    <div style=\"text-align: left; position: fixed; bottom: 4px; left: -1px; width: 100%;\">\n        RFQ / PO No.: {{ doc.name }}\n    </div>\n    <div style=\"text-align: right; position: fixed; bottom: 4px; right: -1px; width: 100%;\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </div>\n</div>\n\n\n\n\n   <table style=\"width:100%;margin-top:-33px; \">\n      <!-- Table Header Section -->\n      <thead>\n         <tr>\n            <td>\n               <!-- Placeholder for the fixed-position header -->\n               <!--<div class=\"page-header-space\"></div>-->\n            </td>\n         </tr>\n      </thead>\n      <!-- Table Body Section -->\n\n      <div style=\"border-left: 2px solid black;\">\n        <tbody\n            style=\"width: 103.2%;margin-top: -11px;margin-left:-11px;border-left: 0px solid black; font-size: 10px;\"> \n            <!--Border left 0 px is left dark border remove-->\n            <td>\n               <table\n                  style=\"width: 103.2%; border-collapse: collapse; border: 2px solid black; width: 103.4%;margin-top: 0px;margin-left:-11px; border-right: 2px solid black;\">\n                  <tr>\n                     <td style=\"text-align: center; border-left: 2px solid black; border-bottom: 2px solid black; \">\n                        <b><u>DELIVERY CHALLAN</u></b>\n                     </td>\n                  </tr>\n               </table>\n               <table style='display:flex; width: 103.4%; margin-top: 0px; margin-left:-11px'>\n                   <tr>\n                  <td style='width:50%; border-left: 2px solid black;'>\n                     <table style=\"display: block; width:100%;\" class='address-table'>\n                        {% if doc.shipping_address_name %}\n                        {% set customer_shipping =\n                        frappe.db.get_value('Address', doc.shipping_address_name, ['address_title', 'address_type',\n                        'address_line1', 'address_line2', 'city', 'country', 'state','pincode',\n                        'gstin','custom_contact_person_name','custom_mobile_no']) %}\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Company &nbsp;Name</td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style='padding: 0 !important;'><b>{{customer_shipping[0] or ''}}</b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Address</td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{doc.shipping_address}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Contact &nbsp;Person</td>\n                           <td style=\"width: 3%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[9] or ''}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Tel No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[10] or ''}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Buyer's GST &nbsp;No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[8] or ''}}</td>\n                        </tr>\n                        {% else %}\n                        {% set customer_billing =\n                        frappe.db.get_value('Address', doc.customer_address, ['address_title', 'address_type',\n                        'address_line1', 'address_line2', 'city', 'country', 'state','pincode',\n                        'gstin','custom_contact_person_name','custom_mobile_no']) %}\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Company &nbsp;Name</td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"><b>{{customer_billing[0] or ''}}</b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Address</td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{doc.address_display or ''}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Contact &nbsp;Person</td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_billing[9] or ''}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\"> &nbsp;Tel No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_billing[10] or ''}}</td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 35%; padding: 0 !important;\"> &nbsp;Buyer's GST&nbsp;No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{customer_billing[8] or ''}}</td>\n                        </tr>\n                        {% endif %}\n                     </table>\n                  </td>\n                  <td style='width:49.9%; border-left: 2px solid black; border-right: 2px solid black;'>\n                     <table style=\"display: block; width:100%;\" class='address-table'>\n                        {% set sales_person =\n                           frappe.db.get_value('Sales Invoice', doc.custom_sales_invoice_no, ['custom_sales_person']) %}\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\"> &nbsp;DC No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> {{doc.name}} </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Dated </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> {{ doc.get_formatted(\"posting_date\") or ' '}} </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;PO No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\">{{doc.po_no or ''}} </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;SO No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Reference </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> {{sales_person or \" \" }} </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Place of Supply </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> {{doc.place_of_supply or ''}} </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;PAN No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> </td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"width: 45%; padding: 0 !important;\"> &nbsp;GST No. </td>\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\n                           <td style=\"padding: 0 !important;\"> {{doc.company_gstin or ''}} </td>\n                        </tr>\n                     </table>\n                  </td>\n                  </tr>\n               </table>\n               <table\n                  style=\"width: 103.4%;margin-top:0px;margin-left:-11px; border-collapse: collapse; border: 2px solid black; border-top:0px solid black; border-bottom: 0px solid black;\">\n                  <tr>\n                     <td>\n                        <table style=\"width: 103.5%;margin-top: -11px;margin-left: -10.7px; \">\n                           <tr>\n                              <th style=\"border: 2px solid black; width:10%; border-left:0px solid black;\">Sr.No.</th>\n                              <th style=\"border: 2px solid black; width:40.1%;\">Name of Product/Service</th>\n                              <th style=\"border: 2px solid black;\">HSN/SAC</th>\n                              <th style=\"border: 2px solid black;\">Qty</th>\n                              <th style=\"border: 2px solid black;border-right:0px solid black;\">Unit</th>\n                           </tr> {% for item in doc.items %} <tr>\n                              <td style=\"border: 2px solid black; border-left:0px solid black;\">{{item.idx}}</td>\n                              <td style=\"border: 2px solid black;\">{{item.custom_item_description or item.item_name}}\n                              </td>\n                              <td style=\"border: 2px solid black;\">{{item.gst_hsn_code or \"\"}}</td>\n                              <td style=\"border: 2px solid black;\">{{item.qty}}</td>\n                              <td style=\"border: 2px solid black;border-right:0px solid black;\">{{item.uom}}</td>\n                           </tr> {% endfor %}\n                           <tr style=\"border-bottom: 2px solid black;\">\n                              <td colspan=5 style='text-align:right'><b>Grand Total </b> {{doc.total_qty}} Units</td>\n                           </tr>\n                        </table>\n                     </td>\n                  </tr>\n                  <tr style=\"border-right: 2px solid black; border-bottom: 1px solid black;\">\n                     <!--<td>-->\n                     <!--   <table style=\"width: 100%;\">-->\n                     <!--      <tr>-->\n                     <td>\n                        <b>Terms & Conditions</b>\n                        {{doc.terms or \" \"}}\n                     </td>\n                     <!--      </tr>-->\n                     <!--   </table>-->\n                     <!--</td>-->\n                  </tr>\n               </table>\n               \n               <table style=\"width: 103.4%; border-collapse: collapse; margin-left:-11px;margin-top:0.2px; border-left:2px solid black; border-right:2px solid black;\">\n                   <tr>\n                       <!--Left Column -->\n                      <td style=\"width: 33.33%; border-right: 2px solid black; border-top: 1px solid black; padding: 0; vertical-align: top;\">\n                         <table style=\"width: 100%; border-collapse: collapse; margin: 0; padding: 0;\">\n                            <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 !important;\"><b>Dispatch Th:</b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 !important;\"><b>Dispatch No:</b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 !important;\"><b>Dispatch Mode:</b></td>\n                        </tr>\n                         </table>\n                      </td>\n                \n                       <!--Middle Column -->\n                      <td style=\"width: 33.33%; border-left: 2px solid black; border-right: 2px solid black; border-top: 1px solid black;  vertical-align: top; padding: 0;\">\n                         <table style=\"width: 100%; border-collapse: collapse; margin: 0; padding: 0;\">\n                           <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b>Received the above goods in good condition.</b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b>Invoice accepted and admitted for payment</b></td>\n                        </tr>\n                           <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b><br><br></b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"margin: 50px;\"><center>Recipient's Signature</center></td>\n                        </tr>\n                         </table>\n                         <!--<p style=\"margin: 0; padding: 5px;\">Recipient's Signature</p>-->\n                      </td>\n                \n                       <!--Right Column -->\n                      <td style=\"width: 33.33%; border-left: 2px solid black; border-top: 1px solid black;\">\n                         <table style=\"width: 100%; border-collapse: collapse;\">\n                            <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b>MANTRA SOFTECH (INDIA) PRIVATE LIMITED</b></td>\n                        </tr>\n                        \n                        <tr style=\"padding: 0 !important;\">\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b><br><br><br><br></b></td>\n                        </tr>\n                        <tr style=\"padding: 0 !important;\">\n                            <td style=\"padding: 0; height: 20px; text-align: center; vertical-align: bottom; padding-bottom: 1px;\"><center>Authorized Signatory</center></td>\n                        </tr>\n                        \n                        <!--<tr style=\"padding: 0 !important;\">-->\n                           <!--<td style=\"margin: 50px;\">Authorized Signatory</td>-->\n                        <!--   <td style=\"padding-bottom: 2px; vertical-align: bottom;\">Authorized Signatory</td>-->\n                        <!--</tr>-->\n                         </table>\n                         <!--<p style=\"margin: 20px;\">Authorized Signatory</p>-->\n                      </td>\n                   </tr>\n                </table>\n\n               \n               <!--<div style='display:flex;  width: 103.1%; margin-top: -1px; margin-left:-11px '>-->\n               <!--   <div style='width:33.33%;border-left:2px solid black;border-top:2px solid black;'>-->\n               <!--      <table style='width:100%;'>-->\n               <!--         <tr style=\"padding: 0 !important;\">-->\n               <!--            <td style=\"padding: 0 0 3px 0 !important;\"><b>&nbsp;Dispatch Th:</b></td>-->\n               <!--         </tr>-->\n               <!--         <tr style=\"padding: 0 0 3px 0 !important;\">-->\n               <!--            <td style=\"padding: 0 !important;\"><b>&nbsp;Dispatch No:</b></td>-->\n               <!--         </tr>-->\n               <!--         <tr style=\"padding: 0 !important;\">-->\n               <!--            <td style=\"padding: 0 !important;\"><b>&nbsp;Dispatch Mode:</b></td>-->\n         