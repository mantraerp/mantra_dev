ft:2px solid black;border-top:2px solid black;border-bottom:2px solid black;border-right:2px solid black;\">\n                  <p> \n                     Registered Office Address: B-203, 2nd Floor, Shapath Hexa, Near Gujarat High Court, Opp. Kargil\n                     Petrol Pump,S.G. Highway,Sola,\n                     Ahmedabad, Gujarat - 380060, India\n                  </p>\n               </div>\n               <!-- Repeat the same structure for additional table sections if needed -->\n               {% set temp = namespace(name=\"no_serial\",repeat=1) %}\n               {% for row in doc.items %}\n               {% if row.serial_and_batch_bundle %}\n               {% set temp.name = \"yes_serial\" %}\n               {% endif %}\n               {% endfor %}\n               {% if temp.name == \"yes_serial\" %}\n               <!--<div class=\"page-break\">-->\n               <!--</div>-->\n               <!--<div class=\"page-header-space\" style=\"margin-bottom:115px;\"></div>-->\n               {% endif %}\n               <table\n                  style=\" border-collapse: collapse; width: 103.4%;margin-left:-11px; position : relative; top : -3px \">\n                  {% set row_count = 0 %}\n                  {% for item in doc.items %}\n                  {% if item.serial_and_batch_bundle %}\n                  <tr style=\" \">\n                     <td colspan=\"2\" style=\"background-color:#c5c5c5;color:black;padding:5px;border:1px solid black; border-top: 1px solid black;border-bottom: 1px solid black;\">\n                        <div style=\"display:flex;justify-content:space-between; \">\n                           <div>{{item.idx}}: {{ item.item_code }}, {{item.item_name}}</div>\n                           <div style=\"text-align:right;\">{{ item.qty }} Units</div>\n                        </div>\n                     </td>\n                  </tr>\n                  <tr style=\" \">\n                     <td colspan=\"2\">\n                       