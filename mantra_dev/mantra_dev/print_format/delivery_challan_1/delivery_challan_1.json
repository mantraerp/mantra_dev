 "html": "{%- from \"templates/print_formats/standard_macros.html\" import add_header, render_field -%}\r\n\r\n<!-- Outer container for the print format with some styling -->\r\n<div class=\"print-format .print-format-preview\" style=\"padding: 0px; \">\r\n   <!-- Page Header Section -->\r\n\r\n\r\n    <div style=\"width: 100%;\">\r\n    <!-- Table Layout for Header -->\r\n        <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed; border: 2px solid black; \">\r\n            <tbody><tr style=\"border: 0px; background: none;\">\r\n                <!-- Left Section -->\r\n                <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">\r\n                    <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">\r\n                    <p style=\"margin: 0; padding-top: 10px; font-size: 13px;\"><b>CIN No.: U72200GJ2006PTC048092</b></p>\r\n                </td>\r\n                <!-- Right Section -->\r\n                <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">\r\n                    <h3 style=\"font-size: 13px; color: cornflowerblue; margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>\r\n                    <p style=\"margin: 0; font-size: 13px;\">(ISO 9001: 2015 COMPANY)</p>\r\n                    <p style=\"margin: 0; font-size: 13px;\">B203-Shapath Hexa, Nr. Gujarat High Court, S.G. Highway</p>\r\n                    <p style=\"margin: 0; font-size: 13px;\">Ahmedabad, Gujarat, India, 380060</p>\r\n                </td>\r\n            </tr>\r\n        </tbody></table>\r\n\r\n    <!-- Separator -->\r\n    <!--<div style=\"width: 100%; border-bottom: 2px solid rgba(0, 0, 0, 0.5);\"></div>-->\r\n    </div>\r\n    \r\n    \r\n    \r\n\r\n\r\n   <!--<div class=\"page-header\">-->\r\n   <!--   {{ add_header(0, 1, doc, letter_head, no_letterhead,page_num ) }}-->\r\n   <!--</div>-->\r\n   <!-- Page Footer Section -->\r\n   <!--<div class=\"page-footer\">-->\r\n   <!--   {{footer or \"\"}}-->\r\n   <!--   {%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead) -%}-->\r\n   <!--   <div style=\"display:block;\"> {{page_num}} of {{max_pages}}</div>-->\r\n   <!--   {%- endmacro -%}-->\r\n\r\n   <!--</div>-->\r\n   <!-- Table for the entire print format -->\r\n   \r\n   \r\n   <div id=\"header-html\" class=\"visible-pdf\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-header\" style=\"padding: 0; margin: 0; height: auto;\">\r\n        <table style=\"border-bottom: 1px solid #ddd; width: 100%; margin: 0; padding: 5px;\">\r\n            <!--<tr style=\"border: 0px; background: none;\">-->\r\n                <!-- Left Section -->\r\n            <!--    <td style=\"width: 44%; text-align: left; padding: 5px; vertical-align: middle; border: 0px;\">-->\r\n            <!--        <img style=\"height: 40px !important; width: 170px !important;\" src=\"/files/Mantra-Logo_1 (1).png\">-->\r\n            <!--        <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">CIN No.: U72200GJ2006PTC048092</p>-->\r\n            <!--        <p style=\"margin: 0; padding-top: 2px; font-size: 12px;\">GSTIN: 24AAECM6360N1Z6</p>-->\r\n            <!--    </td>-->\r\n                <!-- Right Section -->\r\n            <!--    <td style=\"width: 56%; text-align: center; padding: 5px; vertical-align: middle; border: 0px;\">-->\r\n            <!--        {% set doc1 = frappe.get_doc(\"Address\", doc.billing_address) %}-->\r\n            <!--        <h3 style=\"font-size: 13px; margin: 0;\">MANTRA SOFTECH (INDIA) PRIVATE LIMITED</h3>-->\r\n            <!--        <p style=\"margin: 0; font-size: 13px;\">{{ doc1.address_line1 or '' }}, {{ doc1.address_line2 or '' }}</p>-->\r\n            <!--        <p style=\"margin: 0; font-size: 13px;\">{{ doc1.city or '' }}, {{ doc1.state or '' }}, {{ doc1.country or '' }}, {{ doc1.pincode or '' }}</p