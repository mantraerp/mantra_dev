es_serial\" %}\r\n               <!--<div class=\"page-break\">-->\r\n               <!--</div>-->\r\n               <!--<div class=\"page-header-space\" style=\"margin-bottom:115px;\"></div>-->\r\n               {% endif %}\r\n               <table\r\n                  style=\" border-collapse: collapse; width: 103.4%;margin-left:-11px; position : relative; top : -3px \">\r\n                  {% set row_count = 0 %}\r\n                  {% for item in doc.items %}\r\n                  {% if item.serial_and_batch_bundle %}\r\n                  <tr style=\" \">\r\n                     <td colspan=\"2\" style=\"background-color:#c5c5c5;color:black;padding:5px;border:1px solid black; border-top: 1px solid black;border-bottom: 1px solid black;\">\r\n                        <div style=\"display:flex;justify-content:space-between; \">\r\n                           <div>{{item.idx}}: {{ item.item_code }}, {{item.item_name}}</div>\r\n                           <div style=\"text-align:right;\">{{ item.qty }} Units</div>\r\n                        </div>\r\n                     </td>\r\n                  </tr>\r\n                  <tr style=\" \">\r\n                     <td colspan=\"2\">\r\n                        {% set batch_number = frappe.get_doc(\"Serial and Batch Bundle\", item.serial_and_batch_bundle) %}\r\n                        <table\r\n                           style=\"width:103.4%; border-collapse: collapse; margin-top: -11px; margin-left: -11px; margin-bottom: -13px;\">\r\n                           {% set count = namespace(repeat=0) %}\r\n                           <tr style=\"display:flex;flex-wrap:wrap; width:103.6%;\">\r\n                              {% for row in batch_number.entries %}\r\n                              {% set count.repeat = count.repeat + 1 %}\r\n                              \r\n                              {%if ((count.repeat) - 1) % 6 == 0 %}\r\n                              <td style=\"width:16.11%;border:1px solid black;padding:2px 4px;border-top:0px solid black;  margin-top: 0px;\">{{\r\n                                 row.serial_no }}</td>\r\n                                 {%else %}\r\n                                <td style=\"width:16.11%;border:1px solid black;padding:2px 4px;border-top:0px solid black; border-left:0px solid black;  margin-top: 0px;\">{{\r\n                                 row.serial_no }}</td>\r\n                                 {%endif%}\r\n                                 \r\n                              {% if count.repeat % 6 == 0 %}\r\n                           </tr>\r\n                           <!--{% if count.repeat % 20 == 0 %}-->\r\n                           <!--    <tr style=\"display:flex;flex-wrap:wrap;\">-->\r\n                           <!--        <td colspan=\"6\" style=\"border: none;\"></td>-->\r\n                           <!--    </tr>-->\r\n                           <!--{% endif %}-->\r\n                           <tr style=\"display:flex;flex-wrap:wrap; width:103.6%;\">\r\n                              {% endif %}\r\n                              {% endfor %}\r\n                              {% if count.repeat % 6 != 0 %}\r\n                              {% for _ in range(6 - count.repeat % 6) %}\r\n                              <td style=\"width:16.65%;border: none;\"></td>\r\n                              {% endfor %}\r\n                           </tr>\r\n                           {% endif %}\r\n                  </tr>\r\n               </table>\r\n            </td>\r\n            </tr>\r\n            {% endif %}\r\n            {% endfor %}\r\n            \r\n        \r\n   </table>\r\n   </td>\r\n   </tbody>\r\n</div>\r\n\r\n\r\n<!-- Table Footer Section -->\r\n<!--<tfoot>-->\r\n<!--   <tr>-->\r\n<!--      <td>-->\r\n         <!-- Placeholder for the fixed-position footer -->\r\n<!--         <div class=\"page-footer-space\"></div>-->\r\n<!--      </td>-->\r\n<!--   </tr>-->\r\n<!--</tfoot>-->\r\n</table>\r\n\r\n</div>",
