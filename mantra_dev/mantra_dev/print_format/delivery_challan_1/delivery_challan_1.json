le\r\n                  style=\"width: 103.2%; border-collapse: collapse; border: 2px solid black; width: 103.4%;margin-top: 0px;margin-left:-11px; border-right: 2px solid black;\">\r\n                  <tr>\r\n                     <td style=\"text-align: center; border-left: 2px solid black; border-bottom: 2px solid black; \">\r\n                        <b><u>DELIVERY CHALLAN</u></b>\r\n                     </td>\r\n                  </tr>\r\n               </table>\r\n               <table style='display:flex; width: 103.4%; margin-top: 0px; margin-left:-11px'>\r\n                   <tr>\r\n                  <td style='width:50%; border-left: 2px solid black;'>\r\n                     <table style=\"display: block; width:100%;\" class='address-table'>\r\n                        {% if doc.shipping_address_name %}\r\n                        {% set customer_shipping =\r\n                        frappe.db.get_value('Address', doc.shipping_address_name, ['address_title', 'address_type',\r\n                        'address_line1', 'address_line2', 'city', 'country', 'state','pincode',\r\n                        'gstin','custom_contact_person_name','custom_mobile_no']) %}\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Company &nbsp;Name</td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style='padding: 0 !important;'><b>{{customer_shipping[0] or ''}}</b></td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Address</td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{doc.shipping_address}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Contact &nbsp;Person</td>\r\n                           <td style=\"width: 3%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[9] or ''}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Tel No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[10] or ''}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Buyer's GST &nbsp;No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_shipping[8] or ''}}</td>\r\n                        </tr>\r\n                        {% else %}\r\n                        {% set customer_billing =\r\n                        frappe.db.get_value('Address', doc.customer_address, ['address_title', 'address_type',\r\n                        'address_line1', 'address_line2', 'city', 'country', 'state','pincode',\r\n                        'gstin','custom_contact_person_name','custom_mobile_no']) %}\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Company &nbsp;Name</td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"><b>{{customer_billing[0] or ''}}</b></td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Address</td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{doc.address_display or ''}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\">&nbsp;Contact &nbsp;Person</td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_billing[9] or ''}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\"> &nbsp;Tel No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_billing[10] or ''}}</td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 35%; padding: 0 !important;\"> &nbsp;Buyer's GST&nbsp;No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{customer_billing[8] or ''}}</td>\r\n                        </tr>\r\n                        {% endif %}\r\n                     </table>\r\n                  </td>\r\n                  <td style='width:49.9%; border-left: 2px solid black; border-right: 2px solid black;'>\r\n                     <table style=\"display: block; width:100%;\" class='address-table'>\r\n                        {% set sales_person =\r\n                           frappe.db.get_value('Sales Invoice', doc.custom_sales_invoice_no, ['custom_sales_person']) %}\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\"> &nbsp;DC No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> {{doc.name}} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Dated </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> {{ doc.get_formatted(\"posting_date\") or ' '}} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;PO No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\">{{doc.po_no or ''}} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;SO No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Reference </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> {{sales_person or \" \" }} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;Place of Supply </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> {{doc.place_of_supply or ''}} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\">&nbsp;PAN No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"width: 45%; padding: 0 !important;\"> &nbsp;GST No. </td>\r\n                           <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                           <td style=\"padding: 0 !important;\"> {{doc.company_gstin or ''}} </td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                              <td style=\"width: 45%; padding: 0 !important;\"> &nbsp;e-Waybill No. </td>\r\n                              <td style=\"width: 5%; padding: 0 !important;\">:</td>\r\n                              <td style=\"padding: 0 !important;\"> {{doc.ewaybill or ''}} </td>\r\n                        </tr>\r\n                     </table>\r\n                  </td>\r\n                  </tr>\r\n               </table>\r\n               <table\r\n                  style=\"width: 103.4%;margin-top:0px;margin-left:-11px; border-collapse: collapse; border: 2px solid black; border-top:0px solid black; border-bottom: 0px solid black;\">\r\n                  <tr>\r\n                     <td>\r\n                        <table style=\"width: 103.5%;margin-top: -11px;margin-left: -10.7px; \">\r\n                           <tr>\r\n                              <th style=\"border: 2px solid black; width:10%; border-left:0px solid black;\">Sr.No.</th>\r\n                              <th style=\"border: 2px solid black; width:40.1%;\">Name of Product/Service</th>\r\n                              <th style=\"border: 2px solid black;\">HSN/SAC</th>\r\n                              <th style=\"border: 2px solid black;\">Qty</th>\r\n                              <th style=\"border: 2px solid black;border-right:0px solid black;\">Unit</th>\r\n                           </tr> {% for item in doc.items %} <tr>\r\n                              <td style=\"border: 2px solid black; border-left:0px solid black;\">{{item.idx}}</td>\r\n                              <td style=\"border: 2px solid black;\">{{item.custom_item_description or item.item_name}}\r\n                              </td>\r\n                              <td style=\"border: 2px solid black;\">{{item.gst_hsn_code or \"\"}}</td>\r\n                              <td style=\"border: 2px solid black;\">{{item.qty}}</td>\r\n                              <td style=\"border: 2px solid black;border-right:0px solid black;\">{{item.uom}}</td>\r\n                           </tr> {% endfor %}\r\n                           <tr style=\"border-bottom: 2px solid black;\">\r\n                              <td colspan=5 style='text-align:right'><b>Grand Total </b> {{doc.total_qty}} Units</td>\r\n                           </tr>\r\n                        </table>\r\n                     </td>\r\n                  </tr>\r\n                  <tr style=\"border-right: 2px solid black; border-bottom: 1px solid black;\">\r\n                     <!--<td>-->\r\n                     <!--   <table style=\"width: 100%;\">-->\r\n                     <!--      <tr>-->\r\n                     <td>\r\n                        <b>Terms & Conditions</b>\r\n                        {{doc.terms or \" \"}}\r\n                     </td>\r\n                     <!--      </tr>-->\r\n                     <!--   </table>-->\r\n                     <!--</td>-->\r\n                  </tr>\r\n               </table>\r\n               \r\n               <table style=\"width: 103.4%; border-collapse: collapse; margin-left:-11px;margin-top:0.2px; border-left:2px solid black; border-right:2px solid black;\">\r\n                   <tr>\r\n                       <!--Left Column -->\r\n                      <td style=\"width: 33.33%; border-right: 2px solid black; border-top: 1px solid black; padding: 0; vertical-align: top;\">\r\n                         <table style=\"width: 100%; border-collapse: collapse; margin: 0; padding: 0;\">\r\n                            <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"padding: 0 !important;\"><b>Dispatch Th:</b></td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"padding: 0 !important;\"><b>Dispatch No:</b></td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"padding: 0 !important;\"><b>Dispatch Mode:</b></td>\r\n                        </tr>\r\n                         </table>\r\n                      </td>\r\n                \r\n                       <!--Middle Column -->\r\n                      <td style=\"width: 33.33%; border-left: 2px solid black; border-right: 2px solid black; border-top: 1px solid black;  vertical-align: top; padding: 0;\">\r\n                         <table style=\"width: 100%; border-collapse: collapse; margin: 0; padding: 0;\">\r\n                           <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b>Received the above goods in good condition.</b></td>\r\n                        </tr>\r\n                        <tr style=\"padding: 0 !important;\">\r\n                           <td style=\"padding: 0 0 3px 0 !important;\"><b>Invoice accepted and admitted for payment</b></td>\r\n 