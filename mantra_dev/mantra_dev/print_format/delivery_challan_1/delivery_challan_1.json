             <!--<p style=\"margin: 20px;\">Authorized Signatory</p>-->\r\n                      </td>\r\n                   </tr>\r\n                </table>\r\n\r\n               \r\n               <!--<div style='display:flex;  width: 103.1%; margin-top: -1px; margin-left:-11px '>-->\r\n               <!--   <div style='width:33.33%;border-left:2px solid black;border-top:2px solid black;'>-->\r\n               <!--      <table style='width:100%;'>-->\r\n               <!--         <tr style=\"padding: 0 !important;\">-->\r\n               <!--            <td style=\"padding: 0 0 3px 0 !important;\"><b>&nbsp;Dispatch Th:</b></td>-->\r\n               <!--         </tr>-->\r\n               <!--         <tr style=\"padding: 0 0 3px 0 !important;\">-->\r\n               <!--            <td style=\"padding: 0 !important;\"><b>&nbsp;Dispatch No:</b></td>-->\r\n               <!--         </tr>-->\r\n               <!--         <tr style=\"padding: 0 !important;\">-->\r\n               <!--            <td style=\"padding: 0 !important;\"><b>&nbsp;Dispatch Mode:</b></td>-->\r\n               <!--         </tr>-->\r\n               <!--      </table>-->\r\n               <!--   </div>-->\r\n               <!--   <div-->\r\n               <!--      style='width:33.33%;text-align:center;border-top:2px solid black;border-left:2px solid black;border-right:2px solid black; display:flex;flex-direction:column;justify-content:space-between;'>-->\r\n               <!--      <table style='width:100%; display:block;'>-->\r\n               <!--         <tr style=\"padding: 0 !important;\">-->\r\n               <!--            <td style=\"padding: 0 0 3px 0 !important;\"><b>&nbsp;&nbsp;Received the above goods in good condition.</b></td>-->\r\n               <!--         </tr>-->\r\n               <!--         <tr style=\"padding: 0 !important;\">-->\r\n               <!--            <td style=\"padding: 0 0 3px 0 !important;\"><b>&nbsp;&nbsp;Invoice accepted and admitted for payment